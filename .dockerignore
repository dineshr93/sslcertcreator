# keep the build context small and secrets out of the image
.git
.gitignore
.venv/
__pycache__/
*.pyc
container_id.txt
root_cas/

# generated certificate/key material — never bake into the image
*.cnf
*.key
*.csr
*.pem
*.der
*.pfx
*.jks

# not needed inside the image
Dockerfile
README.md
.dockerignore
